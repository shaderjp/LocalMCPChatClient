<Window x:Class="LocalMCPChatClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:MdXaml;assembly=MdXaml"
        Title="Local MCP Chat" Height="820" Width="1280" MinHeight="640" MinWidth="980"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Yu Gothic UI">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#334155" BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="LOCAL MCP CHAT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="18" Margin="4,6,4,14" />
                    <Button Content="＋ 新しいチャット" Command="{Binding NewChatCommand}" HorizontalContentAlignment="Left" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Markdownで保存" Click="ExportMarkdown_Click" />
                    <Button Content="選択中のチャットを削除" Command="{Binding DeleteChatCommand}" />
                    <Button Content="設定" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding SelectedConversation}"
                         Background="Transparent" BorderThickness="0" Margin="0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,6" Width="215">
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="{Binding UpdatedLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,3,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="モデル" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayName" />
                    <TextBlock Grid.Column="2" Text="推論" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Grid.Column="3" ItemsSource="{Binding InferenceModes}" SelectedItem="{Binding SelectedInferenceMode}" />
                    <TextBlock Grid.Column="5" Text="{Binding McpStatusText}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Margin="10,0" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
                <ItemsControl ItemsSource="{Binding Messages}" MaxWidth="900" HorizontalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,7" Padding="16,12" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="#334155" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True"><Setter Property="Background" Value="#0C4A6E" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsTool}" Value="True"><Setter Property="Background" Value="#3F3F46" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="BorderBrush" Value="#F87171" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6" />
                                    <md:MarkdownScrollViewer Markdown="{Binding Content}" Engine="{StaticResource ChatMarkdownEngine}"
                                                             Background="Transparent" Foreground="{StaticResource TextBrush}"
                                                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="18,13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" MaxHeight="180"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="Ctrl+Enterで送信" />
                    <Button Grid.Column="1" Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsBusy}" Margin="10,0,2,0" />
                    <Button Grid.Column="2" Content="再生成" Command="{Binding RegenerateCommand}" />
                    <Button Grid.Column="3" Content="送信" Command="{Binding SendCommand}" Background="#0369A1" MinWidth="80" />
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="#020617" Padding="14,6">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
