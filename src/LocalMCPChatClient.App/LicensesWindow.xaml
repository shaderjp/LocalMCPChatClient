<Window x:Class="LocalMCPChatClient.App.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ライセンス情報" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="18">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="閉じる" IsCancel="True" Click="Close_Click" MinWidth="90" />
            <Button DockPanel.Dock="Right" Content="表示中の内容をコピー" Click="Copy_Click" MinWidth="160" />
            <TextBlock Text="配布物にも同じライセンス・第三者通知ファイルが含まれます。"
                       Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="文書" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="6,4,6,10" />
                    <ListBox x:Name="DocumentList" SelectionChanged="DocumentList_SelectionChanged"
                             Background="{StaticResource ControlBrush}" BorderBrush="#475569"
                             DisplayMemberPath="Title" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="#475569" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock x:Name="DocumentTitle" DockPanel.Dock="Top" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="4,2,4,10" />
                    <TextBox x:Name="DocumentText" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource ControlBrush}" Foreground="{StaticResource TextBrush}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
